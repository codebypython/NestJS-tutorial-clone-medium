# Application Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api
FALLBACK_LANGUAGE=en

# Database Configuration (MySQL)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=conduit_db

# Redis Configuration (Token Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=conduit-secret-key-development-environment
JWT_EXPIRES_IN=24h
